# Voice backend configuration. Copy to `.env` (git-ignored) and fill in.
# Only the server reads these — nothing here is bundled into the browser.

# Gemini: the agent that turns speech into scene commands.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs: speech-to-text (Scribe realtime) and the spoken replies.
# Key: https://elevenlabs.io/app/settings/api-keys
# The default below (Sarah) is a premade voice that works on the free plan.
# Voice Library voices return HTTP 402 "paid_plan_required" unless you upgrade.
# Other free-plan voices: pNInz6obpgDQGcFmaJgB (Adam), JBFqnCBsd6RMkjVDRZzb (George).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Presage SmartSpectra: watches the face for mouth movement so the mic opens
# hands-free. Optional — without it the toolbar voice button toggles manually.
# Key: https://physiology.presagetech.com/auth/register
PRESAGE_API_KEY=

PORT=8787
