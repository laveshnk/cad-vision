{
  "name": "cad-vision-ml",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gesture-recognition ML engine for a gesture-driven CAD application (MediaPipe HandLandmarker).",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:assets": "node scripts/fetch-assets.mjs",
    "postinstall": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "@elevenlabs/elevenlabs-js": "^2.69.0",
    "@google/genai": "^2.24.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "jpeg-js": "^0.4.4",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "@smartspectra/node-sdk": "^3.3.0"
  }
}
